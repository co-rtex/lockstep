+// The order reference a message looks up: the order it adds, modifies or replaces (for U, the
+// original), or 0 for messages that touch no displayed order.
+OrderRef looked_up_ref(const Message& m) noexcept {
+    return std::visit(
+        [](const auto& msg) -> OrderRef {
+            using T = std::decay_t<decltype(msg)>;
+            if constexpr (std::is_same_v<T, OrderReplace>) {
+                return msg.original_ref;
+            } else if constexpr (std::is_same_v<T, AddOrder> || std::is_same_v<T, OrderExecuted> ||
+                                 std::is_same_v<T, OrderExecutedWithPrice> ||
+                                 std::is_same_v<T, OrderCancel> || std::is_same_v<T, OrderDelete>) {
+                return msg.order_ref;
+            } else {
+                return 0;
+            }
+        },
+        m);
+}
+
+// Only the paged index has a cheap address to prefetch; the hash variants do nothing.
+template <typename I>
+void prefetch_slot(const I& index, OrderRef ref) noexcept {
+    if constexpr (requires { index.prefetch(ref); }) {
+        index.prefetch(ref);
+    }
+}
+
+}  // namespace
+
+void BookBuilder::prefetch_index(const Message& m) const noexcept {
+    if (const OrderRef ref = looked_up_ref(m); ref != 0) {
+        prefetch_slot(impl_->index, ref);
+    }
+}
+
+void BookBuilder::prefetch_order(const Message& m) const noexcept {
+    if (std::holds_alternative<AddOrder>(m)) {
+        return;  // a new order has no node yet
+    }
+    if (const OrderRef ref = looked_up_ref(m); ref != 0) {
+        const std::uint32_t slot = impl_->index.find(ref);
+        if (slot != Index::kEmpty) {
+            __builtin_prefetch(&impl_->pool[slot]);
+        }
+    }
+}
