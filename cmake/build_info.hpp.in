#pragma once

// Generated by CMake at configure time. Recorded in benchmark output for reproducibility.
// The git revision is generated at build time instead (git_info.hpp), because a build
// directory is usually configured once and then rebuilt at many commits.
#include "enginex/git_info.hpp"

namespace enginex::build_info {
inline constexpr const char* kVersion = "@PROJECT_VERSION@";
inline constexpr const char* kCompilerId = "@CMAKE_CXX_COMPILER_ID@";
inline constexpr const char* kCompilerVersion = "@CMAKE_CXX_COMPILER_VERSION@";
inline constexpr const char* kBuildType = "@CMAKE_BUILD_TYPE@";
inline constexpr const char* kSanitizer = "@ENGINEX_SANITIZER@";
inline constexpr const char* kSystem = "@CMAKE_SYSTEM_NAME@-@CMAKE_SYSTEM_PROCESSOR@";
}  // namespace enginex::build_info
